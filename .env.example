# ═══════════════════════════════════════
#  云海睿评 - 环境变量配置模板
#  复制此文件为 .env 并填入实际值
# ═══════════════════════════════════════

# 应用基础配置
APP_NAME=云海睿评 - AI绩效评价报告生成系统
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=ai_grade_db
DB_POOL_SIZE=10
DB_POOL_RECYCLE=3600

# JWT 配置（生产环境请使用随机生成的强密钥）
JWT_SECRET_KEY=your_jwt_secret_key_change_me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# 数据库内密钥加密（管理后台填的第三方 API Key 会用它加密后再落库）
# 生成：python -m backend.services.secret_box
# 留空不阻断启动，但 API Key 会以明文存库，启动日志会告警。
# 注意：换掉这个值之后，之前加密存的 Key 将无法解密（需要重新填一遍）。
SECRET_ENCRYPTION_KEY=

# LLM API 密钥（至少配置一个）
DASHSCOPE_API_KEY=your_dashscope_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# 模型配置（默认模型建议使用已配置有效密钥的模型）
DEFAULT_MODEL=deepseek-chat
QWEN_MODELS=qwen3-max
DEEPSEEK_MODELS=
OPENAI_MODELS=
ANTHROPIC_MODELS=

# LangSmith 追踪（可选）
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-grade-performance-evaluation
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# CORS 配置
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# 模型参数
TEMPERATURE=0.7
TOP_P=0.9
MAX_TOKENS=4000